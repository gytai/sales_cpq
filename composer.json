{
    "name": "fastadminnet/fastadmin",
    "description": "the fastest admin framework",
    "type": "project",
    "keywords": [
        "fastadmin",
        "thinkphp"
    ],
    "homepage": "https://www.fastadmin.net/",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Karson",
            "email": "karson@fastadmin.net"
        }
    ],
    "require": {
        "php": ">=7.4.0",
        "topthink/framework": "dev-master",
        "topthink/think-captcha": "^1.0.9",
        "topthink/think-installer": "^1.0.14",
        "topthink/think-queue": "1.1.6",
        "topthink/think-helper": "^1.0.7",
        "fastadminnet/fastadmin-addons": "~1.4.0",
        "fastadminnet/fastadmin-mailer": "^2.0.0",
        "overtrue/pinyin": "^3.0",
        "phpoffice/phpspreadsheet": "^1.29.1",
        "mpdf/mpdf": "^8.1",
        "overtrue/wechat": "^4.6",
        "ext-json": "*",
        "ext-curl": "*",
        "ext-pdo": "*",
        "ext-bcmath": "*"
    },
    "config": {
        "preferred-install": "dist",
        "allow-plugins": {
            "topthink/think-installer": true,
            "easywechat-composer/easywechat-composer": true
        }
    },
    "autoload": {
        "psr-4": {
            "addons\\": "addons/"
        }
    },
    "scripts": {
        "test:cpq": "php tests/cpq/run.php",
        "test:cpq-rules": "php tests/cpq/rule_analysis.php",
        "test:cpq-rule-engine": "php tests/cpq/rule_engine.php",
        "test:cpq-integration": "php tests/cpq/integration.php",
        "test:cpq-poc": "php tests/cpq/poc.php",
        "test:cpq-price-channel": "php tests/cpq/price_channel.php",
        "test:cpq-pricing": "php tests/cpq/pricing.php",
        "test:cpq-m3-platform": "php tests/cpq/m3_platform.php",
        "test:cpq-master-data": "php tests/cpq/master_data.php",
        "test:cpq-quote": "php tests/cpq/quote.php",
        "test:cpq-m3-approval": "php tests/cpq/m3_approval.php",
        "test:cpq-m4-reporting": "php tests/cpq/m4_reporting.php",
        "test:cpq-security": "php tests/cpq/security.php",
        "test:cpq-performance": "php tests/cpq/performance.php",
        "test:cpq-upgrade": "php tests/cpq/upgrade.php",
        "test:cpq-regression": "php tests/cpq/regression.php"
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://gitee.com/fastadminnet/framework.git"
        },
        {
            "type": "git",
            "url": "https://gitee.com/fastadminnet/think-captcha.git"
        }
    ]
}
