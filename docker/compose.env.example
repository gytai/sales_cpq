# docker compose 变量模板：cp docker/compose.env.example .env.docker
# 所有变量在 docker-compose.yml 中均有默认值，本文件只在本机端口冲突或改密码时需要

# Web 入口端口（http://localhost:CPQ_HTTP_PORT）
CPQ_HTTP_PORT=8080
# MySQL 对外端口（容器内固定 3306）
CPQ_MYSQL_PORT=33061
# Redis 对外端口（容器内固定 6379）
CPQ_REDIS_PORT=63791
# 业务库名与 root 密码（仅开发环境使用）
CPQ_MYSQL_DATABASE=fastadmin
CPQ_MYSQL_ROOT_PASSWORD=root
