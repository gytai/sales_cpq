[app]
debug = true
trace = false

[database]
hostname = 127.0.0.1
database = fastadmin
username = root
password = root
hostport = 3306
prefix = fa_

[queue]
; 驱动可选 Redis / Database / Sync；本地无 ext-redis 时可用 Sync 跑通流程
connector = Redis
hostname = 127.0.0.1
hostport = 6379
password =
select = 0

[cpq]
; 至少 32 字节随机值；各环境必须不同，只用于 AES-256-GCM 凭证加密
integration_key =
